# cubet environment variables
# Railway: Project → cubet service → Variables (or `railway variables --set KEY=value`).
# Local:   copy to .env and run `npm start`.

# ---- Data providers (server-only; never sent to the browser) ----
# Solana JSON-RPC used to verify tokens on-chain. The public endpoint works but is rate-limited;
# for production paste a Helius / QuickNode / Triton / Alchemy URL here (it usually contains your key).
SOLANA_RPC_URL=
# Optional: a CoinGecko API key switches charts/trending to CoinGecko's on-chain API (higher limits).
COINGECKO_API_KEY=
# Seconds to cache market data on the server.
DATA_CACHE_SECONDS=20
# Data API requests allowed per minute per visitor.
API_RATE_LIMIT=120

# ---- Bet book ----
# SQLite file for the shared bet book (players, bets, balances, ledger). On Railway it lives on the
# persistent volume mounted at /data. Locally it defaults to data/cubet.db.
# DB_PATH=/data/cubet.db

# ---- Server ----
# PORT is injected by Railway automatically. Don't set it there. Local default: 4174.
# PORT=4174
NODE_ENV=production
# 0.0.0.0 is required on Railway. Use 127.0.0.1 locally.
HOST=0.0.0.0
# Seconds browsers may cache CSS/JS (fonts are always cached for a year). 0 disables caching.
CACHE_MAX_AGE=3600
# Your site's public address, for share-link meta tags. Leave blank on Railway to use the
# generated *.up.railway.app domain automatically. Set it when you add a custom domain.
PUBLIC_URL=

# ---- Branding (public; blank = use config.js) ----
APP_NAME=cubet
APP_TITLE=cubet — stack your call
APP_TAGLINE=Set a market-cap target, find someone who disagrees, and the winner takes the whole stack.
APP_FOOTER=cubet · live Solana market data · demo SOL

# ---- Token (public) ----
# The official cubet token contract address, shown with a copy button on the splash page.
# Blank = the button reads "coming soon". Set it once here so the address is identical everywhere.
TOKEN_CA=

# ---- Demo economy (public; blank = use config.js) ----
CURRENCY=SOL
# Changing this starts every visitor with a fresh demo (their old local data is ignored).
STORAGE_KEY=cubet-v2
MAX_DEPOSIT=1000
DEFAULT_STAKE=0.1

# ---- Art ----
# Optional hand-drawn wobble on the hero scene.
ART_BOIL=false
