# cubet environment variables
# Railway: Project → cubet service → Variables (or `railway variables --set KEY=value`).
# On Railway, settings waiting for a value are set to REPLACE_ME (the dashboard hides empty ones).
# REPLACE_ME counts as blank: replace it with the real value.
# Local:   copy to .env and run `npm start`.

# ---- Data providers (server-only; never sent to the browser) ----
# Solana JSON-RPC used to verify tokens on-chain. The public endpoint works but is rate-limited;
# for production paste a Helius / QuickNode / Triton / Alchemy URL here (it usually contains your key).
SOLANA_RPC_URL=
# Optional: a CoinGecko API key switches charts/trending to CoinGecko's on-chain API (higher limits).
COINGECKO_API_KEY=
# Seconds to cache market data on the server.
DATA_CACHE_SECONDS=20
# Data API requests allowed per minute per visitor.
API_RATE_LIMIT=120

# ---- Bet book ----
# SQLite file for the shared bet book (players, bets, balances, ledger). On Railway it lives on the
# persistent volume mounted at /data. Locally it defaults to data/cubet.db.
# DB_PATH=/data/cubet.db

# ---- Server ----
# PORT is injected by Railway automatically. Don't set it there. Local default: 4174.
# PORT=4174
NODE_ENV=production
# 0.0.0.0 is required on Railway. Use 127.0.0.1 locally.
HOST=0.0.0.0
# Seconds browsers may cache CSS/JS (fonts are always cached for a year). 0 disables caching.
CACHE_MAX_AGE=3600
# Your site's public address, for share-link meta tags. Leave blank on Railway to use the
# generated *.up.railway.app domain automatically. Set it when you add a custom domain.
PUBLIC_URL=

# ---- Branding (public; blank = use config.js) ----
APP_NAME=cubet
APP_TITLE=cubet — stack your call
APP_TAGLINE=Set a market-cap target, find someone who disagrees, and the winner takes the whole stack.
APP_FOOTER=cubet · live Solana market data · real SOL

# ---- Token (public) ----
# The official cubet token contract address, shown with a copy button on the splash page.
# Blank = the button reads "coming soon". Set it once here so the address is identical everywhere.
TOKEN_CA=3NSUeHQXrcwqibJ78MDQ2YcXqL7pyP35b61MraQXpump

# ---- Real SOL: treasury, fees and limits (server-only) ----
# SERVER-ONLY SECRET. The treasury wallet's secret key: it receives deposits and signs withdrawals and fee sweeps.
# Base58 (as Phantom/Solflare export it) or the JSON byte array solana-keygen writes. Use a NEW wallet made only
# for cubet. Whoever reads this can move everything the treasury holds: set it only in Railway's Variables.
# Blank = payments OFF: no deposits, no withdrawals, no new bets (the site says so). Fund it with ~0.01 SOL for rent.
TREASURY_SECRET_KEY=
# Where cubet's fees are swept (a separate wallet you control; never the treasury). Blank = fees stay in the treasury.
FEE_WALLET=
# cubet's fee on each settled pot, in basis points (200 = 2%). 0 = no fee. Shown to players before they bet.
FEE_BPS=0
# Sweep accrued fees to FEE_WALLET once they reach this many SOL.
FEE_SWEEP_MIN=0.1
# mainnet-beta (live). The RPC for payments defaults to SOLANA_RPC_URL; set PAYMENTS_RPC_URL to split the load.
SOLANA_CLUSTER=mainnet-beta
PAYMENTS_RPC_URL=
# Stake limits per bet, in SOL.
MIN_STAKE=0.01
MAX_STAKE=10
# Deposits below this are still credited; it's the smallest amount the deposit form offers.
MIN_DEPOSIT=0.01
# Withdrawal minimum and per-wallet 24-hour cap, in SOL. Each withdrawal pays a 0.00001 SOL network fee.
MIN_WITHDRAW=0.02
MAX_WITHDRAW_PER_DAY=25
# Emergency switch: true pauses withdrawals (balances stay safe and visible).
WITHDRAWALS_PAUSED=false
# A token's top pool needs at least this much liquidity (USD) to be bet on, so thin pools can't be pushed around.
MIN_LIQUIDITY_USD=20000

# ---- Display (public; blank = use config.js) ----
CURRENCY=SOL
# Browser key for the theme preference.
STORAGE_KEY=cubet-v2
# The stake the bet form starts with, in SOL.
DEFAULT_STAKE=0.1

# ---- Art ----
# Optional hand-drawn wobble on the hero scene.
ART_BOIL=false
